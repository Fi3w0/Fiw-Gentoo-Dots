+    READ_VAR(u32, &prop->element);
+    READ_VAR(u32, &prop->scope);
+    READ_VAR(u32, &prop->selector);
+    return 0;
+}
+
+int t2audio_msg_read_set_input_stream_address_ranges_response(struct t2audio_msg *msg)
