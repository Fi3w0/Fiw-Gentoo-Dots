-	switch (vsense_select) {
-	case AW88399_DEV_VDSEL_VSENSE:
-		ret = aw88399_dev_get_vcalk(aw88399, &vcalk);
-		vcal_k = vcalk * AW88399_VCABLK_FACTOR + AW88399_CABL_BASE_VALUE;
