-static void aw88399_startup_work(struct work_struct *work)
-{
-	struct aw88399 *aw88399 =
-		container_of(work, struct aw88399, start_work.work);
-
-	mutex_lock(&aw88399->lock);
-	aw88399_start_pa(aw88399);
-	mutex_unlock(&aw88399->lock);
