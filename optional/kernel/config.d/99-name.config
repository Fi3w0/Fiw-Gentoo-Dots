# uname -r → <linux version>-fiw-nyx-v<own version>, e.g. 7.2.10-fiw-nyx-v1.2.
# Only the kernel version plus Fiw's name: no CachyOS release number or other extras.
# Bump v<N> by hand when you change your own tweaks.
# History: v1 = "-1-fiwzen-v1" (first build), v1.1 = renamed to fiw-nyx,
# v1.2 = 2026-10-08 rebuild (7.2.9, CachyOS 7.2.9-2 patch), "-<cachyos release>" dropped
# from the name from the next kernel build on (first: 7.2.10, CachyOS 7.2.10-1 patch).
CONFIG_LOCALVERSION="-fiw-nyx-v1.2"
