# uname -r → <linux version>-<cachyos release>-fiw-nyx-v<own version>
# e.g. 7.2.7-1-fiw-nyx-v1.1. fiw-cachy-patch updates the cachyos release number;
# bump v<N> by hand when you change your own tweaks.
# History: v1 = "-1-fiwzen-v1" (first build), v1.1 = renamed to fiw-nyx. v1.2 = 2026-10-08 rebuild (7.2.9-2).
CONFIG_LOCALVERSION="-2-fiw-nyx-v1.2"
