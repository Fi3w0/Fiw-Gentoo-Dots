# Mirrors linux-cachyos defaults (7.2 PKGBUILD) on top of Gentoo's dist config.
CONFIG_CACHY=y
# Built on this box → -march=native = znver5
CONFIG_X86_NATIVE_CPU=y
# CONFIG_GENERIC_CPU is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# B850 (Promontory 21) chipset xHCI glue, as in linux-cachyos (the MT7925 BT sits on it)
CONFIG_SENSORS_PROM21_XHCI=m
